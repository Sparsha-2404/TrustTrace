# TrustTrace environment configuration.
# LM Studio uses a local OpenAI-compatible endpoint and does not require a real key.
# Keep the server running at the configured base_url in config.yaml.
TRUSTTRACE_LLM_BASE_URL=http://127.0.0.1:1234/v1

# Set to 1 for research/evaluation runs. MockProvider is rejected in strict mode.
TRUSTTRACE_STRICT_EVAL=1

# Optional diagnostics
TRUSTTRACE_DEBUG=false

# Optional: override the default persistent vector-store path (default: ./data/chroma_db).
# TRUSTTRACE_CHROMA_PATH=D:\TrustTraceData\chroma_db
